{# The bar across the top of every page, and the Moore Foundation note at the bottom. #}
{% extends "kerko/layout.html.jinja2" %}

{%- block favicon %}
<link rel="icon" type="image/png" sizes="16x16" href="{{ url_for('static', filename='favicon-16.png') }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ url_for('static', filename='favicon-32.png') }}">
<link rel="icon" type="image/png" sizes="192x192" href="{{ url_for('static', filename='favicon-192.png') }}">
<link rel="icon" type="image/png" sizes="512x512" href="{{ url_for('static', filename='favicon-512.png') }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ url_for('static', filename='apple-touch-icon.png') }}">
{%- endblock favicon %}

{%- block navbar %}
<nav class="navbar navbar-expand-lg navbar-light oshf-navbar d-print-none">
  <div class="container">
    {%- block navbar_brand %}
    <a href="https://opensciencehardware.org/" class="navbar-brand" title="Open Science Hardware Foundation">
      <img src="{{ url_for('static', filename='logo-h-60px-light.webp') }}"
           alt="Open Science Hardware Foundation"
           class="oshf-brand-logo"
           onerror="this.style.display='none'">
    </a>
    {%- endblock navbar_brand %}
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar-content" aria-controls="navbar-content" aria-expanded="false" aria-label="{{ _('Toggle navigation') }}">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div id="navbar-content" class="collapse navbar-collapse">
      <ul class="navbar-nav ml-auto align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link" href="https://opensciencehardware.org/sponsorship/">Fiscal Sponsorship</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="https://opensciencehardware.org/news/">News</a>
        </li>
        <li class="nav-item oshf-has-sub">
          <a class="nav-link" href="{{ url_for('kerko.search') }}">
            Library
            <svg class="oshf-caret" width="8" height="8" viewBox="0 0 15 15" aria-hidden="true"><path d="M2.1,3.2l5.4,5.4l5.4-5.4L15,4.3l-7.5,7.5L0,4.3L2.1,3.2z"></path></svg>
          </a>
          <ul class="oshf-subnav">
            <li>
              <a href="https://opensciencehardware.org/library-contributions/">Contribute</a>
            </li>
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="https://opensciencehardware.org/about/">About</a>
        </li>
        <li class="nav-item">
          <a class="nav-link oshf-donate" href="https://www.paypal.com/donate/?hosted_button_id=Z65RHPHWGL7FG">Donate</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
{%- endblock navbar %}

{%- block styles %}
{{ super() }}
<link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --oshf-dark: #111518;
    --oshf-green: #53ff75;
    --oshf-green-deep: #16c43c;
    --text: #111518;
    --link: #008ab8;
    --gray-dark: #4b4b4b;
    --gray-mid: #6e6e6e;
    --gray-hover: #e9ecef;
    --gray-light: #f8f9fa;
    --gray-bar: #f2f2f2;
    --border: #dee2e6;
    --muted: #6c757d;
    --font: Urbanist, sans-serif;
  }

  body { font-family: var(--font); color: var(--text); font-weight: 500; }
  h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
    color: var(--oshf-dark);
    font-weight: 600;
  }

  a { color: var(--link); }
  a:hover { color: var(--link); text-decoration: underline; }

  .card, .btn, .badge, .form-control, .custom-select, .input-group-text,
  .page-link, .dropdown-menu, .modal-content, .alert, .list-group-item,
  .breadcrumb, .nav-tabs .nav-link, .input-group > .form-control,
  .input-group > .custom-select, .input-group-append .btn, .input-group-prepend .btn {
    border-radius: 0 !important;
  }

  .btn-primary, .page-item.active .page-link {
    background-color: var(--oshf-green) !important;
    border-color: var(--oshf-green-deep) !important;
    color: var(--oshf-dark) !important;
  }
  .btn-primary:hover,
  .btn-primary:focus {
    background-color: var(--oshf-green-deep) !important;
    border-color: #129632 !important;
    color: var(--oshf-dark) !important;
  }
  .page-link { color: var(--link); }

  .badge {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    padding: .375rem .75rem;
    vertical-align: middle;
  }
  .badge-light { color: var(--text); background-color: var(--gray-light); }

  /* Navbar, matching opensciencehardware.org */
  .oshf-navbar { background: #fff; min-height: 5.5rem; }
  .oshf-brand-logo { height: 60px; width: auto; display: block; }
  .oshf-navbar .nav-link {
    color: var(--oshf-dark) !important;
    font-size: 18px;
    font-weight: 600;
    padding: .75rem 1.5rem !important;
    background: none !important;
  }
  .oshf-navbar .nav-link:hover { opacity: .7; text-decoration: none; }
  .oshf-navbar .nav-link.oshf-donate {
    border: 2px solid var(--oshf-green) !important;
    border-radius: 3px !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    line-height: 1.3 !important;
    padding: 5px 15px !important;
    margin-left: .75rem;
  }
  .oshf-navbar .nav-link.oshf-donate:hover {
    background: var(--oshf-green) !important;
    opacity: 1;
  }
  .oshf-has-sub { position: relative; }
  .oshf-caret {
    display: inline-block;
    margin-left: .35rem;
    vertical-align: middle;
    fill: currentColor;
  }
  .oshf-subnav {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--oshf-dark);
    box-shadow: rgba(41, 51, 61, .1) 0 10px 20px 0;
    min-width: 11rem;
    width: max-content;
  }
  .oshf-subnav a {
    display: block;
    color: #fff !important;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
    padding: 10px 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .oshf-subnav a:hover {
    opacity: .75;
    text-decoration: none;
  }
  @media (min-width: 992px) {
    .oshf-subnav {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 1000;
    }
    .oshf-has-sub:hover > .oshf-subnav,
    .oshf-has-sub:focus-within > .oshf-subnav {
      display: block;
    }
  }
  @media (max-width: 991.98px) {
    .oshf-navbar { min-height: 0; }
    .oshf-brand-logo { height: 48px; }
    .oshf-navbar .nav-link { padding: .75rem 0 !important; }
    .oshf-navbar .nav-link.oshf-donate {
      margin: .5rem 0;
      display: inline-block;
      padding: 5px 15px !important;
    }
    .oshf-subnav {
      display: block;
      background: transparent;
      box-shadow: none;
      min-width: 0;
      width: auto;
      padding: 0 0 0 1rem;
    }
    .oshf-subnav a {
      color: var(--oshf-dark) !important;
      padding: .5rem 0;
    }
  }

  /* Search results */
  .oshf-result { margin-bottom: 1.5rem; }
  .oshf-result-link { display: block; color: var(--text); }
  .oshf-result-link:hover,
  .oshf-result-link:focus {
    color: inherit;
    background-color: var(--gray-hover);
    text-decoration: none;
  }
  .oshf-result-link:focus-visible {
    outline: 2px solid var(--oshf-green-deep);
    outline-offset: -2px;
  }
  .oshf-result-content { display: flex; align-items: flex-start; gap: 1rem; }
  .oshf-result-cover { flex: 0 0 30%; }
  .oshf-result-body { flex: 1; min-width: 0; }
  .oshf-result-author { color: var(--link); margin-bottom: .5rem; }
  .oshf-result-title {
    color: var(--link);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: .35rem;
  }
  .oshf-result-date { margin-bottom: .5rem; }
  .oshf-result-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: .75rem;
    background: #fff;
  }
  .oshf-result-type { color: var(--muted); font-size: .875rem; }
  .oshf-result-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .75rem;
    margin-left: auto;
  }

  /* Covers */
  .oshf-cover-img,
  .oshf-cover-ph {
    width: 100%;
    border: 1px solid var(--border);
    box-shadow: 0 2px 4px rgba(0,0,0,.1);
  }
  .oshf-cover-img { height: auto; background: #fff; display: block; }
  .oshf-cover-ph {
    aspect-ratio: 3 / 4;
    background: var(--gray-hover);
    color: var(--muted);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8px;
  }
  .oshf-cover-ph i { color: var(--gray-mid); font-size: 6rem; }
  .oshf-item-cover .oshf-cover-ph i { font-size: 7.5rem; }

  /* Item page */
  .oshf-item { display: flex; align-items: flex-start; margin-bottom: 1.5rem; }
  .oshf-item-cover { flex: 0 0 260px; margin-right: 1.75rem; }
  .oshf-item-body { flex: 1; min-width: 0; }

  @media (max-width: 767.98px) {
    .oshf-result-link { padding: .85rem; }
    .oshf-result-cover { flex-basis: 36%; }
    .oshf-result-title { font-size: 1.25rem; }
    .oshf-result-footer { padding: .6rem .85rem; }
    .oshf-cover-ph i { font-size: 3.5rem; }
    .oshf-item { flex-direction: column; align-items: stretch; }
    .oshf-item-cover { flex: none; width: 200px; margin: 0 auto 1.25rem; }
    .oshf-item-cover .oshf-cover-ph i { font-size: 4.5rem; }
  }

  /* Funder footer */
  .oshf-funder-footer {
    background: var(--gray-bar);
    color: var(--gray-dark);
    padding: 1.75rem 1rem;
  }
  .oshf-funder-footer .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .oshf-funder-footer p { margin: 0 0 1rem; max-width: 40rem; }
  .oshf-funder-link {
    display: block;
    line-height: 0;
  }
  .oshf-funder-link:hover { opacity: .9; }
  .oshf-moore-logo { display: block; height: 65px; width: auto; }
  @media (max-width: 991.98px) {
    .oshf-moore-logo { height: 52px; }
  }
</style>
{%- endblock styles %}

{%- block footer %}
<footer class="oshf-funder-footer d-print-none">
  <div class="container">
    <p>This library is funded by the Gordon and Betty Moore Foundation.</p>
    <a class="oshf-funder-link" href="https://www.moore.org/" target="_blank" rel="noopener noreferrer">
      <img class="oshf-moore-logo"
           src="{{ url_for('static', filename='moore-logo-PRIMARY.png') }}"
           alt="Gordon and Betty Moore Foundation"
           width="154"
           height="60">
    </a>
  </div>
</footer>
{{ super() }}
{%- endblock footer %}
